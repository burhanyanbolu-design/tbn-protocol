# TBN Protocol Production Environment Configuration
# Copy this to /opt/tbn-protocol/.env on your production server

# Environment
TBN_ENV=production

# Server Configuration
TBN_DOMAIN=tbn.hardinai.co.uk
TBN_SERVER_IP=3.11.229.68

# GitHub BICA Registry
# Create a GitHub personal access token with repo permissions
# and set it here to enable GitHub-backed BICA registry
TBN_GITHUB_TOKEN=
TBN_GITHUB_REPO=burhanyanbolu-design/tbn-bica-registry

# Network Configuration
TBN_NODE_ID=london-primary
TBN_NODE_LOCATION=London, UK

# Logging
TBN_LOG_LEVEL=INFO
TBN_LOG_DIR=/var/log/tbn

# Security
TBN_SECRET_KEY=your-secret-key-here

# Features
TBN_ENABLE_GITHUB_BICA=true
TBN_ENABLE_CERTIFICATION_PORTAL=true
TBN_ENABLE_MULTI_NODE=true