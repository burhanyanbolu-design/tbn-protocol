[Unit]
Description=TBN Protocol — Trusted Bot Network API Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tbn-protocol
ExecStart=/opt/tbn-protocol/.venv/bin/gunicorn \
    --workers 1 \
    --bind 127.0.0.1:5004 \
    --timeout 120 \
    --preload \
    --access-logfile /var/log/tbn/access.log \
    --error-logfile /var/log/tbn/error.log \
    "server:app"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=TBN_ENV=production

[Install]
WantedBy=multi-user.target
