# TBN Protocol — .gitignore
# Aggressive exclusion of secrets and sensitive files

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Virtual environments
.env
.env.*
!.env.example
.venv/
venv/
env/

# Build / dist
dist/
build/

# OS
.DS_Store
Thumbs.db

# SECRETS & CREDENTIALS
*.pem
*.key
.ssh_temp_key*
id_rsa*
id_ed25519*
*.ppk
known_hosts

# API keys / cookies / tokens / sessions
*cookies*.txt
*cookies*.json
instagram_cookies.*
instagram_browser_cookies.*
instaloader_session*
*.session
.netrc
api_keys.json
credentials.json
service-account*.json

# TBN signing keys (private)
data/tbn_signing_key.pem
data/tbn_master.pem

# SESSION CONTEXT (may contain credentials)
data/SESSION-CONTEXT-*.md
docs/SESSION-CONTEXT-*.md

# PATCH / DEBUG / TEMP SCRIPTS
api/patch_*.py
api/do_patch*.py
api/final_patch.py
api/check_syntax.py
api/test_pw_*.py
api/test_ig_*.py
api/test_graphql*.py
