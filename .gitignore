api/setup_ig_session.py
api/video_agent_patch.py
api/deploy_memory.py
api/deploy_v2.py
api/apply_patch.py
api/fix_*.py
api/cleanup_*.py
transfer_file.py
fix_*.py
cleanup_*.py
read_blog_config.py
check_registry.py
setup_github_bica.py
generate_shango_key.py
check_shango_usage.py
register_demo_agents.py
add_blog_post*.py
rebuild_blog.py

# TEST OUTPUTS
certification_portal_base64.txt
temp_cert.html
*.tmp.html

# CONFIDENTIAL / INTERNAL
