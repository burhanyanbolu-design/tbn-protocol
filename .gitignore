# TBN Protocol — .gitignore
# Aggressive exclusion of secrets and sensitive files

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Virtual environments
.env
.env.*
!.env.example
.venv/
venv/
env/

# Build / dist
dist/
build/

# OS
.DS_Store
Thumbs.db

