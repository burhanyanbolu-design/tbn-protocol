[Unit]
Description=Hardin-AI Phone Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hardin-ai-phone
ExecStart=/usr/bin/python3 /opt/hardin-ai-phone/dashboard.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
